{
  "name": "@openclaw/token-usage-dashboard",
  "version": "1.0.0",
  "description": "Real-time token usage monitoring and analytics dashboard for OpenClaw",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "npm run build:components && npm run build:styles",
    "build:components": "rollup -c",
    "build:styles": "postcss src/styles/main.css -o public/styles.css",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "docker:build": "docker build -t openclaw/token-dashboard .",
    "docker:run": "docker run -p 3000:3000 openclaw/token-dashboard"
  },
  "keywords": [
    "openclaw",
    "token",
    "usage",
    "dashboard",
    "analytics",
    "monitoring",
    "ai",
    "cost"
  ],
  "author": "OpenClaw Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "chart.js": "^4.0.0",
    "lit": "^3.0.0",
    "ws": "^8.0.0",
    "redis": "^4.0.0",
    "moment": "^2.29.0",
    "helmet": "^7.0.0",
    "compression": "^1.7.0",
    "winston": "^3.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "jest": "^29.0.0",
    "supertest": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "postcss": "^8.0.0",
    "autoprefixer": "^10.0.0",
    "cssnano": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw.git",
    "directory": "packages/token-usage-dashboard"
  },
  "bugs": {
    "url": "https://github.com/openclaw/openclaw/issues"
  },
  "homepage": "https://github.com/openclaw/openclaw/tree/main/packages/token-usage-dashboard#readme",
  "files": [
    "src/",
    "public/",
    "config/",
    "docs/",
    "package.json",
    "README.md",
    "LICENSE"
  ]
}